# Local environment files contain passwords and must not be committed.
.env
api/.env

# Installed JavaScript dependencies (recreate with npm install).
node_modules/
**/node_modules/

# Local npm logs and operating-system metadata.
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
Thumbs.db
.DS_Store

# Ignore accidental files created while entering a password in PowerShell.
/POSTGRES_PASSWORD=*
